{
  "name": "google-maps-vector-engine",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "High-performance TypeScript engine for rendering Mapbox Vector Tiles (MVT/PBF) on Google Maps with advanced features including fast feature lookups, interactive selections, dynamic styling, and optimized rendering.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsup",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:performance": "jest --config=jest.performance.config.js",
    "test:performance:report": "node scripts/run-performance-tests.js --output=performance-report.md",
    "test:performance:benchmark": "node scripts/run-performance-tests.js --benchmark --output=benchmark-report.md",
    "test:performance:memory": "node scripts/run-performance-tests.js --memory --output=memory-report.md",
    "test:performance:full": "node scripts/run-performance-tests.js --benchmark --memory --verbose --output=full-performance-report.md",
    "test:performance:integration": "jest tests/performance/MVTIntegration.performance.test.ts --config=jest.performance.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm run check:examples",
    "size": "size-limit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:examples": "tsc -p examples/react"
  },
  "keywords": [
    "google-maps",
    "vector-tiles",
    "mvt",
    "pbf",
    "typescript",
    "mapping",
    "gis",
    "performance",
    "interactive"
  ],
  "author": "Mohamed Ali Hachicha <medalihachicha@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medali-07/google-maps-vector-engine.git"
  },
  "bugs": {
    "url": "https://github.com/medali-07/google-maps-vector-engine/issues"
  },
  "homepage": "https://github.com/medali-07/google-maps-vector-engine#readme",
  "peerDependencies": {
    "@types/google.maps": "^3.0.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@turf/intersect": "^7.4.0",
    "@turf/union": "^7.4.0",
    "pbf": "^4.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.15.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^5.16.0",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pbf": "3.0.5",
    "@types/react": "^19.2.18",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.12.0",
    "jest": "^29.0.0",
    "jest-canvas-mock": "^2.4.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "rimraf": "^5.0.0",
    "size-limit": "^11.2.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "funding": [
    {
      "type": "buy-me-a-coffee",
      "url": "https://buymeacoffee.com/medali.07"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/medalihachicha"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "dist/google-maps-vector-engine.min.js",
  "jsdelivr": "dist/google-maps-vector-engine.min.js",
  "peerDependenciesMeta": {
    "@types/google.maps": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "ESM entry (tree-shaken, deps external)",
      "path": "dist/index.mjs",
      "import": "{ MVTSource }",
      "limit": "34 kB"
    },
    {
      "name": "CDN bundle (everything inlined)",
      "path": "dist/google-maps-vector-engine.min.js",
      "limit": "36 kB"
    }
  ]
}
